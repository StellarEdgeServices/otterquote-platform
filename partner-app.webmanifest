{
  "name": "Otter Quotes Partners",
  "short_name": "OQ Partners",
  "description": "Refer homeowners, grow your partner network, and track your referrals and payouts with Otter Quotes.",
  "id": "/partner-app",
  "start_url": "/partner-dashboard.html?source=pwa",
  "scope": "/partner",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0D1B2E",
