  "icons": [
    {
      "src": "/img/app/partner-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/img/app/partner-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/img/app/partner-icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/img/app/partner-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Refer a Homeowner",
      "short_name": "Refer Homeowner",
      "url": "/partner-dashboard.html?source=pwa&action=refer-homeowner",
      "icons": [
        {
          "src": "/img/app/partner-icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Refer a Partner",
      "short_name": "Refer Partner",
      "url": "/partner-dashboard.html?source=pwa&action=refer-partner",
      "icons": [
        {
          "src": "/img/app/partner-icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
